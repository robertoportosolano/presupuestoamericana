# Copia este archivo como .env (local) y define estas variables en Vercel (Project Settings > Environment Variables)

# Cadena de conexion de PostgreSQL.
# En Vercel Postgres / Neon usa la variable "POSTGRES_URL" o "DATABASE_URL" que te entregan.
# Debe empezar por postgresql:// (si viene como postgres:// el codigo lo corrige solo).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd?sslmode=require

# Clave secreta para firmar los tokens JWT. Genera una aleatoria y larga.
# Ejemplo para generarla:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Minutos de validez del token de sesion (opcional, por defecto 720 = 12h)
ACCESS_TOKEN_EXPIRE_MINUTES=720
